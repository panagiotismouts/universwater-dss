# DSS Environment Variables Template
# Copy this file to dss/.env and fill in the secret values.
# The file is loaded by docker-compose.yml (env_file: .env).
# DSS_MONGO_URI and DSS_SERVICE_NAME are set per-container in docker-compose.yml
# and do NOT need to appear here.
# NEVER commit .env to version control.
# All variables use the DSS_ prefix.

# ── Runtime environment ───────────────────────────────────────────────────────
# docker-compose.yml overrides DSS_ENV=docker automatically.
# Set to "local" for running services outside Docker.
DSS_ENV=local

# ── MongoDB ───────────────────────────────────────────────────────────────────
# docker-compose.yml sets DSS_MONGO_URI=mongodb://mongo:27017 automatically.
# Override here only when running outside Docker:
# DSS_MONGO_URI=mongodb://localhost:27017
DSS_MONGO_DB_NAME=dss

# ── Logging ───────────────────────────────────────────────────────────────────
DSS_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
DSS_LOG_FORMAT=human                   # json | human  (use json in Docker/server)

# ── External APIs — WINGS (OAuth2 client_credentials) ────────────────────────
# Base URL and SSO URL have sensible defaults; only override if staging/prod differs.
DSS_WINGS_API_BASE_URL=https://serv-api.staging.wi-sense-water.eu
DSS_WINGS_SSO_URL=https://serv-sso.staging.wi-sense-water.eu/auth/realms/wi-sense-water/protocol/openid-connect/token
DSS_WINGS_CLIENT_ID=universWater
DSS_WINGS_CLIENT_SECRET=your-wings-client-secret-here

# ── External APIs — UOWM (no authentication required) ────────────────────────
DSS_UOWM_API_BASE_URL=http://universwater.ece.uowm.gr

# ── ML Engine ─────────────────────────────────────────────────────────────────
DSS_MODEL_ARTIFACT_PATH=./artifacts    # Absolute path on server/Docker volume mount

# ── API Service ───────────────────────────────────────────────────────────────
DSS_API_HOST=0.0.0.0
DSS_API_PORT=8000
DSS_JWT_SECRET_KEY=change-me-use-a-long-random-secret
DSS_JWT_ALGORITHM=HS256
DSS_ADMIN_API_KEY=change-me-use-a-long-random-admin-key

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Set to true for first run to fetch full historical data
DSS_BOOTSTRAP_MODE=false

# ── Optional config path override ────────────────────────────────────────────
# DSS_CONFIG_PATH=/path/to/config.yaml
